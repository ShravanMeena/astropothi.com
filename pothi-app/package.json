{
  "name": "pothi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "sitemap": "node scripts/build_sitemap.js",
    "prebuild": "node scripts/build_content.js && node scripts/build_sitemap.js && node scripts/legal_check.js",
    "legal:check": "node scripts/legal_check.js",
    "predeploy": "node scripts/build_sitemap.js --strict && node scripts/legal_check.js --strict",
    "og": "node scripts/build_og.js",
    "prerender": "node scripts/prerender.js",
    "seo:check": "node scripts/seo_check.js",
    "postbuild": "node scripts/prerender.js $PRERENDER_ARGS",
    "build:deploy": "node scripts/events_check.js && node scripts/build_og.js && PRERENDER_ARGS=--strict npm run build && node scripts/seo_check.js --strict",
    "content": "node scripts/build_content.js",
    "content:check": "node scripts/build_content.js --check",
    "banners": "node scripts/build_banners.js",
    "video": "node scripts/build_video.js",
    "events:check": "node scripts/events_check.js"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
