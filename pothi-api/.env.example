NODE_ENV=development
PORT=4050

PG_HOST=localhost
PG_PORT=5432
PG_DB=pothi
PG_USER=
PG_PASSWORD=

JWT_SECRET=change-me-in-production
# Dev only: this OTP logs in any phone. config.js nulls it when NODE_ENV=production,
# but leave it empty in a production .env anyway.
OTP_BYPASS=2262

# Where the buyer's browser lives. Razorpay redirects here after a payment link is
# paid, and the WhatsApp button's base URL is frozen against it at template approval.
# MUST be the real domain in production.
WEB_ORIGIN=http://localhost:5190

# Checkout signs the buyer in on the phone number alone, with no OTP. Set to false
# to require the OTP instead — see the note in config.js for what this trades away.
AUTO_LOGIN_ON_ORDER=true

# Consumer payments use Razorpay Payment Links, not the checkout SDK.
# Without keys, checkout falls back to a clearly-labelled dev path.
# Stamped on every payment link (reference id, notes, description) so this
# site's payments are filterable in a Razorpay account shared with other products.
RAZORPAY_SOURCE_TAG=POTHI
RAZORPAY_ID=
RAZORPAY_SECRET=
# Must match the secret entered when registering the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp delivery via MSG91. An empty auth key means dry-run: the payload is built
# and logged, nothing is sent and nothing is charged.
# The auth key is IP-whitelisted — whitelist this server's static outbound IP.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_NAMESPACE=
MSG91_TEMPLATE_REPORT_READY=booking_confirmation_pothi_reports
MSG91_TEMPLATE_LANG=en

# Report PDFs. With no S3_PUBLIC_BASE they are written to ./out and served from
# /files — which is also the only form the in-browser reader accepts today.
S3_BUCKET=pothi-content
S3_REGION=ap-south-1
S3_PUBLIC_BASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Places Autocomplete + Geocoding for the birth place. Without it the form falls
# back to 296 bundled cities, which cannot resolve a town or a village — and a
# wrong coordinate moves the ascendant. Same key as devpunya-node-api-server.
GOOGLE_MAPS_API_KEY=

PILOT_MODE=true
PILOT_SEATS=10
PILOT_REPORTS=10
PILOT_INVITE_CODE=POTHI10

# What goes on the imprint page of a consumer report — never a pandit's details.
CONSUMER_BRAND_NAME=Pothi
CONSUMER_BRAND_TAGLINE=Vedic reports, computed and explained
CONSUMER_SUPPORT_PHONE=
CONSUMER_SUPPORT_EMAIL=
CONSUMER_LOGO_URL=

# Free credits granted to a new astrologer outside the pilot.
TRIAL_CREDITS=10

# The report assistant. Set ONE of these; with neither, "Ask your report" falls
# back to quoting the buyer's own chapters instead of answering conversationally.
# Bedrock (preferred — same account and region as devpunya-node-api-server).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
# Bulk chapter expansion — a writing job, not a reasoning one. Haiku is ~10x faster.
BEDROCK_ENRICH_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODEL_ID=

# Direct vendor keys, for local work without AWS credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MAX_QUESTIONS=60
# Expand thin chapters with written explanation at generation time.
# Facts stay computed; false ships the templates untouched.
AI_ENRICH_REPORTS=true
